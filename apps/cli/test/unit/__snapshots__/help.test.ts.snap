exports[`help text > help for run 1`] = `
"Usage: anchor run [options] -- <command> [args...]

Run a command with the environment's secrets injected as environment variables

Arguments:
  command           the command to run, after --

Options:
  --no-override     keep existing environment variables instead of Anchor values
  --expand          expand \${KEY} references in values (default)
  --no-expand       inject stored values without expanding references
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor run -- npm start
  $ anchor run --env prod --path /api -- node server.js

"
`;

exports[`help text > help for secrets 1`] = `
"Usage: anchor secrets [options] [command]

Manage secrets in the current project, environment and path

Options:
  -h, --help                display help for command

Global Options:
  --version                 print the CLI version
  --json                    print machine-readable JSON on stdout
  -q, --quiet               suppress progress messages
  --no-color                disable colored output
  --debug                   print request diagnostics to stderr (never secret values)
  --api-url <url>           Anchor server URL
  --project <slug>          project slug
  --env <slug>              environment slug
  --path <path>             secret folder path
  -y, --yes                 skip confirmations

Commands:
  list [options]            List secret names and metadata (values only with --reveal)
  get [options] <key>       Print one secret (the value is masked in a terminal unless --reveal)
  history <key>             List the versions of a secret (no values)
  rollback [options] <key>  Restore a past version as a new version (asks for confirmation; --yes in
                            scripts)
  set [options] <key>       Create or update a secret; the value comes from stdin, --from-file or a
                            prompt
  delete <key>              Delete a secret (asks for confirmation; --yes in scripts)
  help [command]            display help for command
"
`;

exports[`help text > help for secrets delete 1`] = `
"Usage: anchor secrets delete [options] <key>

Delete a secret (asks for confirmation; --yes in scripts)

Arguments:
  key               secret key

Options:
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor secrets delete OLD_KEY
  $ anchor secrets delete OLD_KEY --yes

"
`;

exports[`help text > help for secrets get 1`] = `
"Usage: anchor secrets get [options] <key>

Print one secret (the value is masked in a terminal unless --reveal)

Arguments:
  key               secret key

Options:
  --reveal          show the value in a terminal
  --expand          expand \${KEY} references in the value (default)
  --no-expand       print the stored value without expanding references
  --at-version <n>  read a past version (stored value, not expanded)
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor secrets get DB_URL --reveal
  $ anchor secrets get DB_URL > db-url.txt
  $ anchor secrets get DB_URL --at-version 2 --reveal

"
`;

exports[`help text > help for secrets history 1`] = `
"Usage: anchor secrets history [options] <key>

List the versions of a secret (no values)

Arguments:
  key               secret key

Options:
