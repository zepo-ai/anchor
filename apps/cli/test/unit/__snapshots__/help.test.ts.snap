// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help text > help for anchor 1`] = `
"Usage: anchor [options] [command]

Anchor secrets manager CLI

Options:
  --version                   print the CLI version
  --json                      print machine-readable JSON on stdout
  -q, --quiet                 suppress progress messages
  --no-color                  disable colored output
  --debug                     print request diagnostics to stderr (never secret values)
  --api-url <url>             Anchor server URL
  --project <slug>            project slug
  --env <slug>                environment slug
  --path <path>               secret folder path
  -y, --yes                   skip confirmations
  -h, --help                  display help for command

Commands:
  login [options]             Log in with email and password and store a CLI session (30 days)
  logout                      Revoke the stored session on the server and delete it locally
  whoami                      Show the current user or service token
  init                        Link this directory to a project and default environment
                              (.anchor.json)
  projects                    Discover projects
  envs                        Discover environments of a project
  secrets                     Manage secrets in the current project, environment and path
  folders                     Manage folders in the current project and environment
  run [options] [command...]  Run a command with the environment's secrets injected as environment
                              variables
  export [options]            Write the environment's secrets as dotenv, JSON or YAML (file mode
                              0600)
  tokens                      Manage service tokens for CI and servers
  help [command]              display help for command
"
`;

exports[`help text > help for envs 1`] = `
"Usage: anchor envs [options] [command]

Discover environments of a project

Options:
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Commands:
  list              List the environments of the current project
  help [command]    display help for command
"
`;

exports[`help text > help for envs list 1`] = `
"Usage: anchor envs list [options]

List the environments of the current project

Options:
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
