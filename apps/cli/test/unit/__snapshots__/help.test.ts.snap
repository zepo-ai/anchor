exports[`help text > help for login 1`] = `
"Usage: anchor login [options]

Log in with email and password and store a CLI session (30 days)

Options:
  --email <email>   account email (prompted when omitted in a terminal)
  --password-stdin  read the password from stdin (for scripts)
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor login --api-url https://anchor.example.com
  $ printf '%s' "$PASSWORD" | anchor login --email me@example.com --password-stdin

"
`;

