`;

exports[`help text > help for export 1`] = `
"Usage: anchor export [options]

Write the environment's secrets as dotenv, JSON or YAML (file mode 0600)

Options:
  --format <format>  output format (choices: "dotenv", "json", "yaml", default: "dotenv")
  --output <file>    write to a file instead of stdout
  --expand           expand \${KEY} references in values (default)
  --no-expand        write stored values without expanding references
  -h, --help         display help for command

Global Options:
  --version          print the CLI version
  --json             print machine-readable JSON on stdout
  -q, --quiet        suppress progress messages
  --no-color         disable colored output
  --debug            print request diagnostics to stderr (never secret values)
  --api-url <url>    Anchor server URL
  --project <slug>   project slug
  --env <slug>       environment slug
  --path <path>      secret folder path
  -y, --yes          skip confirmations

Examples:
  $ anchor export --output .env.local
  $ anchor export --format json --env prod > secrets.json

"
`;

exports[`help text > help for folders 1`] = `
"Usage: anchor folders [options] [command]

Manage folders in the current project and environment

Options:
  -h, --help               display help for command

Global Options:
  --version                print the CLI version
  --json                   print machine-readable JSON on stdout
  -q, --quiet              suppress progress messages
  --no-color               disable colored output
  --debug                  print request diagnostics to stderr (never secret values)
  --api-url <url>          Anchor server URL
  --project <slug>         project slug
  --env <slug>             environment slug
  --path <path>            secret folder path
  -y, --yes                skip confirmations

Commands:
  list                     List the subfolders of --path (default /)
  create <path>            Create a folder and its parents (no-op if it exists)
  delete [options] <path>  Delete an empty folder; --force also deletes its secrets and subfolders
  help [command]           display help for command
"
`;

exports[`help text > help for folders create 1`] = `
"Usage: anchor folders create [options] <path>

Create a folder and its parents (no-op if it exists)

Arguments:
  path              folder path from the root, e.g. /api/v2

Options:
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor folders create /api
  $ anchor folders create /api/v2 --env prod

"
`;

exports[`help text > help for folders delete 1`] = `
"Usage: anchor folders delete [options] <path>

Delete an empty folder; --force also deletes its secrets and subfolders

Arguments:
  path              folder path from the root

Options:
  --force           delete the secrets and subfolders inside it too
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor folders delete /old
  $ anchor folders delete /old --force --yes

"
`;

