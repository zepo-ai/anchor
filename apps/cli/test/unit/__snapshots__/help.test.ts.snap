exports[`help text > help for secrets rollback 1`] = `
"Usage: anchor secrets rollback [options] <key>

Restore a past version as a new version (asks for confirmation; --yes in scripts)

Arguments:
  key               secret key

Options:
  --to <n>          the version to restore
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Examples:
  $ anchor secrets rollback DB_URL --to 2
  $ anchor secrets rollback DB_URL --to 2 --yes

"
`;

exports[`help text > help for secrets set 1`] = `
"Usage: anchor secrets set [options] <key>

Create or update a secret; the value comes from stdin, --from-file or a prompt

Arguments:
  key                 secret key

Options:
  --from-file <path>  read the value from a file (exact bytes)
  --comment <text>    comment stored with the secret
  -h, --help          display help for command

Global Options:
  --version           print the CLI version
  --json              print machine-readable JSON on stdout
  -q, --quiet         suppress progress messages
  --no-color          disable colored output
  --debug             print request diagnostics to stderr (never secret values)
  --api-url <url>     Anchor server URL
  --project <slug>    project slug
  --env <slug>        environment slug
  --path <path>       secret folder path
  -y, --yes           skip confirmations

Examples:
  $ anchor secrets set DB_URL            # prompts for the value
  $ printf '%s' "$DB_URL" | anchor secrets set DB_URL
  $ anchor secrets set TLS_KEY --from-file key.pem

"
`;

exports[`help text > help for tokens 1`] = `
"Usage: anchor tokens [options] [command]

Manage service tokens for CI and servers

Options:
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
  --no-color        disable colored output
  --debug           print request diagnostics to stderr (never secret values)
  --api-url <url>   Anchor server URL
  --project <slug>  project slug
  --env <slug>      environment slug
  --path <path>     secret folder path
  -y, --yes         skip confirmations

Commands:
  create [options]  Create a service token (printed once on stdout)
  list              List the project's service tokens
  revoke <id>       Revoke a service token (asks for confirmation; --yes in scripts)
  help [command]    display help for command
"
`;

exports[`help text > help for tokens create 1`] = `
"Usage: anchor tokens create [options]

Create a service token (printed once on stdout)

Options:
  --name <name>              token name
  --scope <env[:path]>       environment and optional path prefix; repeatable (default: current env,
                             /)
  --permission <permission>  access level (choices: "read", "read-write", default: "read")
  --expires-in <days>        lifetime in days (1-365) (default: "90")
  -h, --help                 display help for command

Global Options:
  --version                  print the CLI version
  --json                     print machine-readable JSON on stdout
  -q, --quiet                suppress progress messages
  --no-color                 disable colored output
  --debug                    print request diagnostics to stderr (never secret values)
  --api-url <url>            Anchor server URL
  --project <slug>           project slug
  --env <slug>               environment slug
  --path <path>              secret folder path
  -y, --yes                  skip confirmations

Examples:
  $ anchor tokens create --name ci --scope prod --permission read
  $ anchor tokens create --name deploy --scope prod:/api --expires-in 30 --json

"
`;

exports[`help text > help for tokens list 1`] = `
"Usage: anchor tokens list [options]

List the project's service tokens

Options:
  -h, --help        display help for command

Global Options:
  --version         print the CLI version
  --json            print machine-readable JSON on stdout
  -q, --quiet       suppress progress messages
